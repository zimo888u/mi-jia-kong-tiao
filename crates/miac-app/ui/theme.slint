// theme.slint —— Codex-like graphite workspace theme
//
// 视觉方向：低对比石墨底、克制的面板层级、单一紫色操作强调。
// 所有页面的尺寸与颜色都从这里派生，避免局部组件各自“跑风格”。

export global Dark {
    out property <color> bg:          #171717;
    out property <color> bg-soft:     #1f1f1f;
    out property <color> panel:       #242424;
    out property <color> panel-hi:    #2c2c2c;
    out property <color> line:        #3b3b3b;
    out property <color> line-soft:   #303030;
    out property <color> text:        #f4f4f5;
    out property <color> text-dim:    #b5b5ba;
    out property <color> text-mute:   #85858d;
    out property <color> accent:      #a78bfa;
    out property <color> accent-deep: #8b5cf6;
    out property <color> warm:        #f59e0b;
    out property <color> green:       #34d399;
    out property <color> red:         #fb7185;
    out property <color> amber:       #fbbf24;
    out property <color> on-accent:   #ffffff;
    out property <brush> sidebar:     #151515;
    out property <brush> nav-active:  #2b2439;
    out property <brush> brand-mark:  @linear-gradient(135deg, #8b5cf6 0%, #5b21b6 100%);
    out property <brush> dial-track:  #3a3546;
    out property <color> overlay:     rgba(0, 0, 0, 0.68);
}

export global Light {
    out property <color> bg:          #f5f5f6;
    out property <color> bg-soft:     #ededf0;
    out property <color> panel:       #ffffff;
    out property <color> panel-hi:    #f8f8fa;
    out property <color> line:        #d8d8de;
    out property <color> line-soft:   #e6e6eb;
    out property <color> text:        #202023;
    out property <color> text-dim:    #5f5f68;
    out property <color> text-mute:   #91919b;
    out property <color> accent:      #7c3aed;
    out property <color> accent-deep: #6d28d9;
    out property <color> warm:        #d97706;
    out property <color> green:       #16a34a;
    out property <color> red:         #dc2626;
    out property <color> amber:       #d97706;
    out property <color> on-accent:   #ffffff;
    out property <brush> sidebar:     #f0f0f2;
    out property <brush> nav-active:  #ebe5f8;
    out property <brush> brand-mark:  @linear-gradient(135deg, #a78bfa 0%, #6d28d9 100%);
    out property <brush> dial-track:  #e4e0eb;
    out property <color> overlay:     rgba(20, 20, 24, 0.36);
}

export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg:          dark ? Dark.bg          : Light.bg;
    out property <color> bg-soft:     dark ? Dark.bg-soft     : Light.bg-soft;
    out property <color> panel:       dark ? Dark.panel       : Light.panel;
    out property <color> panel-hi:    dark ? Dark.panel-hi    : Light.panel-hi;
    out property <color> line:        dark ? Dark.line        : Light.line;
    out property <color> line-soft:   dark ? Dark.line-soft   : Light.line-soft;
    out property <color> text:        dark ? Dark.text        : Light.text;
    out property <color> text-dim:    dark ? Dark.text-dim    : Light.text-dim;
    out property <color> text-mute:   dark ? Dark.text-mute   : Light.text-mute;
    out property <color> accent:      dark ? Dark.accent      : Light.accent;
    out property <color> accent-deep: dark ? Dark.accent-deep : Light.accent-deep;
    out property <color> warm:        dark ? Dark.warm        : Light.warm;
    out property <color> green:       dark ? Dark.green       : Light.green;
    out property <color> red:         dark ? Dark.red         : Light.red;
    out property <color> amber:       dark ? Dark.amber        : Light.amber;
    out property <color> on-accent:   dark ? Dark.on-accent   : Light.on-accent;
    out property <brush> sidebar:     dark ? Dark.sidebar     : Light.sidebar;
    out property <brush> nav-active:  dark ? Dark.nav-active  : Light.nav-active;
    out property <brush> brand-mark:  dark ? Dark.brand-mark  : Light.brand-mark;
    out property <brush> dial-track:  dark ? Dark.dial-track  : Light.dial-track;
    out property <color> overlay:     dark ? Dark.overlay     : Light.overlay;

    // 一套统一的间距和圆角，保证卡片、侧栏、选项的边缘能对齐。
    out property <length> radius:     12px;
    out property <length> radius-sm:  8px;
    out property <length> sidebar-w:  220px;
    out property <length> topbar-h:   58px;
    out property <length> pad:        20px;
    out property <length> gap:        12px;

    out property <length> font-xs:    11px;
    out property <length> font-sm:    12px;
    out property <length> font-md:    13px;
    out property <length> font-lg:    15px;
    out property <length> font-xl:    20px;
    out property <length> font-2xl:   28px;
    out property <length> font-3xl:   46px;
}
