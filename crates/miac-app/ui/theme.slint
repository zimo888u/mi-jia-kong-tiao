// Sage desktop theme — shared by all five native pages.
export global Dark {
    out property <color> bg:          #17231e;
    out property <color> bg-soft:     #203027;
    out property <color> panel:       #25362d;
    out property <color> panel-hi:    #304638;
    out property <color> line:        #47604d;
    out property <color> line-soft:   #34483a;
    out property <color> text:        #eef4e9;
    out property <color> text-dim:    #c0ccbb;
    out property <color> text-mute:   #97aa94;
    out property <color> accent:      #a9c68c;
    out property <color> accent-deep: #87a86c;
    out property <color> warm:        #dab780;
    out property <color> green:       #b0ce99;
    out property <color> red:         #f39791;
    out property <color> amber:       #e0bf87;
    out property <color> on-accent:   #213522;
    out property <brush> sidebar:     #1b2a22;
    out property <brush> nav-active:  #304638;
    out property <brush> brand-mark:  @linear-gradient(135deg, #87a86c 0%, #35513d 100%);
    out property <brush> dial-track:  #3b5140;
    out property <color> overlay:     rgba(0, 0, 0, 0.68);
}

export global Light {
    out property <color> bg:          #f5f7f3;
    out property <color> bg-soft:     #f0f4ec;
    out property <color> panel:       #ffffff;
    out property <color> panel-hi:    #eaf0e3;
    out property <color> line:        #d5dfce;
    out property <color> line-soft:   #e5ebe0;
    out property <color> text:        #263b35;
    out property <color> text-dim:    #52684e;
    out property <color> text-mute:   #71816c;
    out property <color> accent:      #365f43;
    out property <color> accent-deep: #284e3e;
    out property <color> warm:        #8b6b43;
    out property <color> green:       #527c45;
    out property <color> red:         #b6433c;
    out property <color> amber:       #8b6b43;
    out property <color> on-accent:   #ffffff;
    out property <brush> sidebar:     #eff3ec;
    out property <brush> nav-active:  #e2ebdb;
    out property <brush> brand-mark:  @linear-gradient(135deg, #a9c68c 0%, #284e3e 100%);
    out property <brush> dial-track:  #e2e9da;
    out property <color> overlay:     rgba(20, 20, 24, 0.36);
}

export global Theme {
    in-out property <bool> dark: false;

    out property <color> bg:          dark ? Dark.bg          : Light.bg;
    out property <color> bg-soft:     dark ? Dark.bg-soft     : Light.bg-soft;
    out property <color> panel:       dark ? Dark.panel       : Light.panel;
    out property <color> panel-hi:    dark ? Dark.panel-hi    : Light.panel-hi;
    out property <color> line:        dark ? Dark.line        : Light.line;
    out property <color> line-soft:   dark ? Dark.line-soft   : Light.line-soft;
    out property <color> text:        dark ? Dark.text        : Light.text;
    out property <color> text-dim:    dark ? Dark.text-dim    : Light.text-dim;
    out property <color> text-mute:   dark ? Dark.text-mute   : Light.text-mute;
    out property <color> accent:      dark ? Dark.accent      : Light.accent;
    out property <color> accent-deep: dark ? Dark.accent-deep : Light.accent-deep;
    out property <color> warm:        dark ? Dark.warm        : Light.warm;
    out property <color> green:       dark ? Dark.green       : Light.green;
    out property <color> red:         dark ? Dark.red         : Light.red;
    out property <color> amber:       dark ? Dark.amber        : Light.amber;
    out property <color> on-accent:   dark ? Dark.on-accent   : Light.on-accent;
    out property <brush> sidebar:     dark ? Dark.sidebar     : Light.sidebar;
    out property <brush> nav-active:  dark ? Dark.nav-active  : Light.nav-active;
    out property <brush> brand-mark:  dark ? Dark.brand-mark  : Light.brand-mark;
    out property <brush> dial-track:  dark ? Dark.dial-track  : Light.dial-track;
    out property <color> overlay:     dark ? Dark.overlay     : Light.overlay;

    out property <color> sage-panel: dark ? #344732 : #e8eedf;
    out property <color> dial-fill: dark ? #a9c68c : #84aa6d;
    out property <color> nav-text: dark ? #eef4e9 : #284e3e;
    out property <color> energy-bg: #2e4a3c;
    out property <color> energy-text: #f0f5e9;
    out property <color> energy-muted: #bdcdb5;

    // 一套统一的间距和圆角，保证卡片、侧栏、选项的边缘能对齐。
    out property <length> radius:     14px;
    out property <length> radius-sm:  10px;
    out property <length> sidebar-w:  220px;
    out property <length> topbar-h:   116px;
    out property <length> pad:        32px;
    out property <length> gap:        20px;

    out property <length> font-xs:    11px;
    out property <length> font-sm:    12px;
    out property <length> font-md:    13px;
    out property <length> font-lg:    18px;
    out property <length> font-xl:    20px;
    out property <length> font-2xl:   28px;
    out property <length> font-3xl:   64px;
}
