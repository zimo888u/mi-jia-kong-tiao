// ─────────────────────────────────────────────────────────────────────────────
// ui/login.slint —— 小米账号扫码登录弹层
//
// 对应 v1 的 #login 覆盖层：用米家 App 扫码 → 手机确认 → 选设备 → 写凭据。
//
// 五个状态由 `state` 驱动：
//   0 idle     还没开始（显示「开始扫码登录」按钮）
//   1 loading  正在向小米申请二维码
//   2 qr       二维码已就绪，等手机确认（显示二维码图片与倒计时）
//   3 devices  已确认，仅列出空调和温湿度计，让用户选择空调
//   4 error    出错了，显示原因并可重试
// ─────────────────────────────────────────────────────────────────────────────

import { Theme } from "theme.slint";

/// 设备列表里的一项。
export struct LoginDevice {
    name: string,
    model: string,
    did: string,
    detail: string,
    selectable: bool,
}

export component LoginModal inherits Rectangle {
    in property <int> state: 0;
    in property <image> qr: @image-url("");
    in property <string> status: "";
    in property <string> error: "";
    in property <int> seconds-left: 0;
    in property <[LoginDevice]> devices: [];
    in property <int> selected: 0;

    callback start();
    callback cancel();
    callback retry();
    callback pick(int);
    callback confirm();

    background: Theme.overlay;
    forward-focus: modal-focus;
    init => { modal-focus.focus(); }

    // Keep the modal in charge of keyboard focus, including Tab navigation.
    // Enter must never reach a previously focused property editor behind it.
    modal-focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape { root.cancel(); }
            accept
        }
        key-released(event) => { accept }
    }
    // The backdrop consumes both clicks and wheel events. Device-list scrolling
    // still works because its Flickable is above this area in the input tree.
    TouchArea {
        clicked => { modal-focus.focus(); }
        scroll-event(event) => { accept }
    }

    // 居中卡片
    Rectangle {
        width: 420px;
        height: min(parent.height - 60px, card.preferred-height + 48px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius;
        background: Theme.dialog-panel;
        border-width: 1px;
        border-color: Theme.line;

        card := VerticalLayout {
            padding: 24px;
            spacing: 14px;

            Text {
                text: "登录米家账号";
                color: Theme.text;
                font-size: Theme.font-xl;
                font-weight: 600;
                horizontal-alignment: center;
            }

            // ── 状态 0：还没开始 ──
            if root.state == 0 : VerticalLayout {
                spacing: 12px;
                Text {
                    text: "用已登录这台空调的米家 App 扫码，在手机上确认即可，无需输入密码。";
                    color: Theme.text-dim;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Rectangle {
                    height: 40px;
                    border-radius: Theme.radius-sm;
                    background: start-touch.has-hover ? Theme.accent-deep : Theme.accent;
                    Text {
                        text: "开始扫码登录";
                        color: Theme.on-accent;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    start-touch := TouchArea { mouse-cursor: pointer; clicked => { root.start(); } }
                }
            }

            // ── 状态 1：申请中 ──
            if root.state == 1 : VerticalLayout {
                spacing: 10px;
                height: 120px;
                alignment: center;
                Text {
                    text: "正在向小米申请二维码…";
                    color: Theme.text-dim;
                    font-size: Theme.font-md;
                    horizontal-alignment: center;
                }
            }

            // ── 状态 2：二维码 ──
            if root.state == 2 : VerticalLayout {
                spacing: 10px;
                Rectangle {
                    height: 260px;
                    Rectangle {
                        // 在整行中居中二维码，深色主题也保留白色扫描背景。
                        background: #ffffff;
                        border-radius: 12px;
                        width: 260px;
                        height: 260px;
                        x: (parent.width - self.width) / 2;
                        Image {
                            source: root.qr;
                            width: parent.width - 20px;
                            height: parent.height - 20px;
                            x: 10px;
                            y: 10px;
                            image-fit: contain;
                        }
                    }
                }
                Text {
                    text: "打开米家 App 的「扫一扫」，扫描上方二维码";
                    color: Theme.text-dim;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.seconds-left > 0
                        ? "二维码 " + root.seconds-left + " 秒后过期"
                        : "二维码已过期";
                    color: root.seconds-left > 30 ? Theme.text-mute : Theme.amber;
                    font-size: Theme.font-xs;
                    horizontal-alignment: center;
                }
            }

            // ── 状态 3：选设备 ──
            if root.state == 3 : VerticalLayout {
                spacing: 8px;
                Text {
                    text: "扫码成功，请选择要控制的空调：";
                    color: Theme.text-dim;
                    font-size: Theme.font-sm;
                }
                device-list := Flickable {
                    height: min(root.devices.length * 52px - 8px, min(352px, root.height - 320px));
                    content-width: self.width;
                    content-height: device-rows.preferred-height;
                    interactive: true;
                    device-rows := VerticalLayout {
                        width: device-list.width;
                        spacing: 8px;
                        for device[i] in root.devices : Rectangle {
                            height: 44px;
                            border-radius: Theme.radius-sm;
                            background: root.selected == i ? Theme.nav-active : Theme.bg-soft;
                            border-width: 1px;
                            border-color: root.selected == i ? Theme.accent : Theme.line-soft;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: device.name;
                                    color: Theme.text;
                                    font-size: Theme.font-md;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: device.detail;
                                    color: Theme.text-mute;
                                    font-size: Theme.font-xs;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea {
                                enabled: device.selectable;
                                mouse-cursor: device.selectable ? pointer : default;
                                clicked => { root.pick(i); }
                            }
                        }
                    }
                }
            }

            // ── 状态 4：错误 ──
            if root.state == 4 : VerticalLayout {
                spacing: 10px;
                Text {
                    text: root.error;
                    color: Theme.red;
                    font-size: Theme.font-sm;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // 状态提示（非错误）
            if root.status != "" : Text {
                text: root.status;
                color: Theme.text-mute;
                font-size: Theme.font-xs;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            // ── 底部按钮 ──
            HorizontalLayout {
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 96px;
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: cancel-touch.has-hover ? Theme.panel-hi : transparent;
                    border-width: 1px;
                    border-color: Theme.line;
                    Text {
                        text: root.state == 3 ? "取消登录" : "稍后再说";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    cancel-touch := TouchArea { mouse-cursor: pointer; clicked => { root.cancel(); } }
                }
                if root.state == 2 || root.state == 4 : Rectangle {
                    width: 110px;
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: retry-touch.has-hover ? Theme.panel-hi : Theme.panel;
                    border-width: 1px;
                    border-color: Theme.line;
                    Text {
                        text: "重新生成二维码";
                        color: Theme.text-dim;
                        font-size: Theme.font-sm;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    retry-touch := TouchArea { mouse-cursor: pointer; clicked => { root.retry(); } }
                }
                if root.state == 3 : Rectangle {
                    in property <bool> can-confirm: root.selected >= 0
                        && root.selected < root.devices.length && root.devices[root.selected].selectable;
                    width: 110px;
                    height: 34px;
                    border-radius: Theme.radius-sm;
                    background: !self.can-confirm ? Theme.text-mute
                        : confirm-touch.has-hover ? Theme.accent-deep : Theme.accent;
                    Text {
                        text: "用这个设备";
                        color: Theme.on-accent;
                        font-size: Theme.font-sm;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    confirm-touch := TouchArea {
                        enabled: parent.can-confirm;
                        mouse-cursor: parent.can-confirm ? pointer : default;
                        clicked => { root.confirm(); }
                    }
                }
            }
        }
    }
}
