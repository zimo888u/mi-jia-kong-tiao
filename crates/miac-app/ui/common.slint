// ─────────────────────────────────────────────────────────────────────────────
// ui/common.slint —— 页面共用的小组件
//
// 对应 style.css 里的 .card / .seg / .toggle / .btn / .kv / .hint 等类，
// 抽出来避免五个页面各写一遍。
// ─────────────────────────────────────────────────────────────────────────────

import { Theme } from "theme.slint";
import { CharacterIcon } from "senren.slint";

// Compact line icons used by the macOS sidebar.
export component NavIcon inherits Path {
    in property <int> kind: 0;
    in property <color> icon-color: Theme.accent;
    width: 20px; height: 20px;
    viewbox-width: 24; viewbox-height: 24; fit: preserve;
    fill: transparent; stroke: icon-color; stroke-width: 1.7px;
    stroke-line-cap: round; stroke-line-join: round;
    commands: kind == 0 ? "M 3 5 H 21 V 13 H 3 Z M 6 9 H 18 M 6 16 V 19 M 12 16 V 21 M 18 16 V 19"
        : kind == 1 ? "M 4 18 V 12 M 10 18 V 8 M 16 18 V 3 M 3 21 H 21"
        : kind == 2 ? "M 2 12 H 7 L 10 4 L 14 20 L 17 12 H 22"
        : kind == 3 ? "M 3 6 H 8 M 12 6 H 21 M 3 12 H 14 M 18 12 H 21 M 3 18 H 5 M 9 18 H 21 M 8 4 H 12 V 8 H 8 Z M 14 10 H 18 V 14 H 14 Z M 5 16 H 9 V 20 H 5 Z"
        : kind == 5 ? "M 12 3 C 7 3 3 7 3 12 C 3 17 7 21 12 21 H 14 C 16 21 16 18 14 17 C 12 16 13 14 15 14 H 18 C 23 14 22 3 12 3 Z M 7 10 L 7 10.2 M 10 7 L 10 7.2 M 15 7 L 15 7.2 M 18 10 L 18 10.2"
        : "M 10 2 H 14 L 14.8 5 L 17 6.3 L 20 5.5 L 22 9 L 19.8 11 V 13 L 22 15 L 20 18.5 L 17 17.7 L 14.8 19 L 14 22 H 10 L 9.2 19 L 7 17.7 L 4 18.5 L 2 15 L 4.2 13 V 11 L 2 9 L 4 5.5 L 7 6.3 L 9.2 5 Z M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8";
}

// ── 卡片 ────────────────────────────────────────────────────────
export component Card inherits Rectangle {
    in property <string> title: "";
    in property <string> hint: "";
    // 卡片头部右侧的自定义内容放这里（比如「清空」按钮、日/月切换）

    background: Theme.panel;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.line-soft;
    drop-shadow-color: Theme.macos ? rgba(0, 0, 0, 0.035) : transparent;
    drop-shadow-blur: Theme.macos ? 8px : 0px;
    drop-shadow-offset-y: Theme.macos ? 2px : 0px;
    // 标题行和内容行使用明确的内边距，避免卡片高度变化时选项整体漂移。
    height: content.preferred-height + 2 * 24px + (title == "" ? 0px : 40px);

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        if root.title != "" : HorizontalLayout {
            height: 28px;
            spacing: 12px;
            if Theme.senren : CharacterIcon { kind: Theme.page-icon; width: 26px; height: 26px; }
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-lg;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.hint;
                color: Theme.text-mute;
                font-size: Theme.font-xs;
                vertical-alignment: center;
                visible: root.hint != "";
            }
            Rectangle { horizontal-stretch: 1; }
        }

        content := VerticalLayout {
            spacing: 12px;
            @children
        }
    }
}

// ── 分段选择按钮 ─────────────────────────────────────────────────
export component SegButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> accent: false;      // 「Max」「防直吹」这类强调项
    in property <bool> power-icon: false;
    in property <length> min-w: 46px;
    callback clicked;

    height: Theme.macos ? 32px : 40px;
    // 选项宽度由调用方显式决定，保证同一组按钮边缘严格对齐。
    // 文本本身铺满按钮盒子，不再用 preferred-width 反推外框。
    min-width: min-w;
    preferred-width: min-w;
    border-radius: Theme.radius-sm;
    background: active ? (seg-touch.pressed ? Theme.accent-deep : Theme.control-active)
                       : (seg-touch.has-hover ? Theme.panel-hi : Theme.control-idle);
    border-width: 1px;
    border-color: active ? Theme.accent : (Theme.macos || seg-touch.has-hover ? Theme.line : Theme.line-soft);

    // 显式铺满按钮盒子；只设置 horizontal-alignment 会让不同字宽的中文
    // 文本按自己的 preferred-width 绘制，正是之前“选项偏移”的来源。
    label-text := Text {
        visible: !root.power-icon;
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.active ? Theme.on-accent : (root.accent ? Theme.accent : Theme.text-dim);
        font-size: Theme.font-sm;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if root.power-icon : HorizontalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        alignment: center;
        spacing: 6px;

        VerticalLayout {
            width: 16px;
            height: root.height;
            alignment: center;
            Path {
                width: 16px;
                height: 16px;
                commands: "M 12.4 4.3 A 6 6 0 1 1 3.6 4.3 M 8 1.5 L 8 8.5";
                stroke: root.active ? Theme.on-accent : Theme.text-dim;
                stroke-width: 1.8px;
                stroke-line-cap: round;
                stroke-line-join: round;
            }
        }
        Text {
            height: root.height;
            text: root.label;
            color: root.active ? Theme.on-accent : Theme.text-dim;
            font-size: Theme.font-sm;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    seg-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── 开关行（.toggle）─────────────────────────────────────────────
export component ToggleRow inherits Rectangle {
    in property <string> label;
    in property <bool> on: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 46px;
    border-radius: Theme.radius-sm;
    background: row-touch.has-hover ? Theme.panel-hi : transparent;
    border-width: 0px;
    border-color: Theme.line-soft;

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        padding-left: 11px;
        padding-right: 11px;
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            height: root.height;
            text: root.label;
            color: root.on ? Theme.text : Theme.text-dim;
            font-size: Theme.font-md;
            vertical-alignment: center;
        }
        // 仿 iOS 的滑动开关
        VerticalLayout {
            width: 38px;
            height: root.height;
            alignment: center;
            Rectangle {
                width: 38px;
                height: 22px;
                border-radius: 11px;
                background: root.on ? Theme.accent : (Theme.macos ? #c5c5cb : Theme.line);
                border-width: 1px;
                border-color: root.on ? Theme.accent : Theme.line;
                animate background { duration: 140ms; }
                Rectangle {
                    width: 16px; height: 16px;
                    y: 2px;
                    x: root.on ? parent.width - 19px : 2px;
                    border-radius: 8px;
                    background: #ffffff;
                    animate x { duration: 140ms; easing: ease-in-out; }
                }
            }
        }
    }

    row-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// ── 键值行（.kv-row）────────────────────────────────────────────
export component KvRow inherits Rectangle {
    in property <string> key: "";
    in property <string> value: "--";
    in property <color> value-color: Theme.text;

    height: 34px;
    background: transparent;
    HorizontalLayout {
        spacing: 12px;
        Text { text: root.key; color: Theme.text-dim; font-size: Theme.font-sm; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: Theme.font-sm;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// ── 小按钮（.btn）──────────────────────────────────────────────
export component FlatButton inherits Rectangle {
    in property <string> label;
    in property <length> min-w: 72px;
    in property <bool> danger: false;
    in property <bool> ghost: false;
    callback clicked;

    height: Theme.macos ? 32px : 38px;
    // 和 SegButton 一样，按钮外框不再由文本 preferred-width 反推，
    // 避免文本铺满按钮后形成布局回路。
    min-width: min-w;
    preferred-width: min-w;
    border-radius: Theme.radius-sm;
    background: danger
        ? (btn-touch.has-hover ? Theme.red : transparent)
        : (btn-touch.has-hover ? Theme.panel-hi : (ghost ? transparent : Theme.panel));
    border-width: ghost ? 0px : 1px;
    border-color: danger ? Theme.red : Theme.line;

    btn-text := Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        text: root.label;
        color: root.danger ? (btn-touch.has-hover ? Theme.bg : Theme.red) : Theme.text;
        font-size: Theme.font-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    btn-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── 指标块（.metric / .stat）───────────────────────────────────
export component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <string> sub: "";
    in property <color> value-color: Theme.text;

    background: transparent;
    height: 62px;
    VerticalLayout {
        spacing: 2px;
        alignment: center;
        Text { text: root.label; color: Theme.text-mute; font-size: Theme.font-xs; }
        HorizontalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.value;
                color: root.value-color;
                font-size: 30px;
                font-weight: 600;
                vertical-alignment: bottom;
            }
            Text {
                text: root.unit;
                color: Theme.text-mute;
                font-size: Theme.font-sm;
                vertical-alignment: bottom;
                visible: root.unit != "";
            }
        }
        Text { text: root.sub; color: Theme.text-mute; font-size: Theme.font-xs; visible: root.sub != ""; }
    }
}
