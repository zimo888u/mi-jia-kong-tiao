import { Theme } from "../theme.slint";
import { Card, SegButton, ToggleRow, Metric } from "../common.slint";
import { DialMath } from "../dial-math.slint";

// Geometry uses degrees, matching Slint's trigonometric API. The ring consists
// of small overlapping circles, so the software renderer needs no SVG assets.
component TempDial inherits Rectangle {
    in property <float> value: 26;
    callback adjusted(float);
    width: 300px; height: 300px;
    background: transparent;
    Rectangle { x: 36px; y: 36px; width: 228px; height: 228px; border-radius: 114px; background: Theme.bg-soft; }
    for i in 181 : Rectangle {
        width: 12px; height: 12px; border-radius: 6px;
        x: 144px + DialMath.point-x((DialMath.tick-angle(i, 181) - 90), 126) * 1px;
        y: 144px + DialMath.point-y((DialMath.tick-angle(i, 181) - 90), 126) * 1px;
        background: i <= round(DialMath.ratio(root.value, 16, 31) * 180) ? Theme.dial-fill : Theme.dial-track;
    }
    Rectangle {
        width: 20px; height: 20px; border-radius: 10px;
        x: 140px + DialMath.point-x((DialMath.tick-angle(round(DialMath.ratio(root.value, 16, 31) * 180), 181) - 90), 126) * 1px;
        y: 140px + DialMath.point-y((DialMath.tick-angle(round(DialMath.ratio(root.value, 16, 31) * 180), 181) - 90), 126) * 1px;
        background: Theme.accent; border-width: 3px; border-color: Theme.panel;
    }
    VerticalLayout {
        x: 44px; y: 86px; width: 212px; height: 126px;
        alignment: center; spacing: 6px;
        Text { text: "设定温度"; color: Theme.text-mute; font-size: 12px; horizontal-alignment: center; }
        Text { text: root.value + "°"; color: Theme.accent; font-size: 64px; font-weight: 400; horizontal-alignment: center; }
        Text { text: "拖动或滚轮调节 · 每档 0.5°C"; color: Theme.text-mute; font-size: 10px; horizontal-alignment: center; }
    }
    dial-touch := TouchArea {
        property <float> pressed-value: root.value;
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { self.pressed-value = root.value; }
        }
        moved => { root.adjusted(max(16, min(31, round((self.pressed-value + (self.pressed-y - self.mouse-y) / 18px) * 2) / 2))); }
        scroll-event(e) => {
            if e.delta-y > 0 { root.adjusted(min(31, root.value + 0.5)); }
            else if e.delta-y < 0 { root.adjusted(max(16, root.value - 0.5)); }
            accept
        }
    }
}

export component ControlPage inherits VerticalLayout {
    in property <float> target-temp: 26.0;
    in property <bool> power-on: true;
    in property <string> power-text: "运行中";
    in property <string> room-temp: "--";
    in property <string> sensor-temp: "--";
    in property <string> sensor-hum: "--";
    in property <string> energy-total: "--";
    in property <string> battery-text: "";
    in property <int> mode: 2;
    in property <int> fan: 0;
    in property <int> wind: 0;
    in property <int> vpos: 0;
    in property <int> hpos: 0;
    in property <bool> vswing: false;
    in property <bool> hswing: false;
    in property <bool> eco: false;
    in property <bool> sleep: false;
    in property <bool> heater: false;
    in property <bool> dryer: false;
    in property <bool> favorite: false;
    in property <bool> wind-on: false;
    in property <float> preset-a: 27.5;
    in property <float> preset-b: 27.0;
    in property <float> preset-c: 26.5;

    callback set-target-temp(float);
    callback toggle-power();
    callback set-mode(int);
    callback set-fan(int);
    callback set-wind(int);
    callback set-vpos(int);
    callback set-hpos(int);
    callback set-toggle(string, bool);
    callback set-preset(float);

    spacing: Theme.gap;
    HorizontalLayout {
        spacing: Theme.gap;
        VerticalLayout {
            width: (root.width - Theme.gap) * 0.62;
            spacing: Theme.gap;
            Card {
                title: "米家空调";
                hint: root.power-text;
                HorizontalLayout {
                    height: 38px;
                    Text { text: "调到喜欢的温度，让舒适自然发生。"; color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    SegButton { label: root.power-on ? "⏻  已开机" : "⏻  已关机"; width: 140px; active: root.power-on; clicked => { root.toggle-power(); } }
                }
                HorizontalLayout {
                    height: 310px; alignment: center; spacing: 24px;
                    VerticalLayout { alignment: center; SegButton { label: "−"; min-w: 46px; clicked => { root.set-target-temp(max(16, root.target-temp - 0.5)); } } }
                    Rectangle { width: 300px; height: 300px; TempDial { value: root.target-temp; adjusted(v) => { root.set-target-temp(v); } } }
                    VerticalLayout { alignment: center; SegButton { label: "+"; min-w: 46px; clicked => { root.set-target-temp(min(31, root.target-temp + 0.5)); } } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    SegButton { horizontal-stretch: 1; label: "制冷"; active: root.mode == 2; clicked => { root.set-mode(2); } }
                    SegButton { horizontal-stretch: 1; label: "除湿"; active: root.mode == 3; clicked => { root.set-mode(3); } }
                    SegButton { horizontal-stretch: 1; label: "送风"; active: root.mode == 4; clicked => { root.set-mode(4); } }
                    SegButton { horizontal-stretch: 1; label: "制热"; active: root.mode == 5; clicked => { root.set-mode(5); } }
                }
            }
            Card {
                title: "风随心动"; hint: "风速 · 摆风";
                HorizontalLayout {
                    spacing: 6px;
                    SegButton { label: "自动"; min-w: 58px; active: root.fan == 0; clicked => { root.set-fan(0); } }
                    for i in 7 : SegButton { horizontal-stretch: 1; min-w: 32px; label: "" + (i + 1); active: root.fan == i + 1; clicked => { root.set-fan(i + 1); } }
                    SegButton { label: "Max"; min-w: 46px; active: root.fan == 8; clicked => { root.set-fan(8); } }
                }
                HorizontalLayout {
                    spacing: 12px;
                    ToggleRow { horizontal-stretch: 1; label: "上下摆风"; on: root.vswing; toggled(v) => { root.set-toggle("verticalSwing", v); } }
                    ToggleRow { horizontal-stretch: 1; label: "左右扫风"; on: root.hswing; toggled(v) => { root.set-toggle("horizontalSwing", v); } }
                }
            }
    // ── 温度预设 ──────────────────────────────────────────────
    Card {
        title: "常用温度"; background: Theme.sage-panel;
        hint: "关机时仅保存，开机后自动应用";
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                horizontal-stretch: 1; height: 54px;
                border-radius: Theme.radius-sm;
                background: preset1.has-hover ? Theme.panel-hi : Theme.bg-soft;
                border-width: 0px; border-color: Theme.line;
                HorizontalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: "" + root.preset-a; color: Theme.text; font-size: Theme.font-xl; font-weight: 600; vertical-alignment: center; }
                    Text { text: "℃"; color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; }
                }
                preset1 := TouchArea { mouse-cursor: pointer; clicked => { root.set-preset(root.preset-a); } }
            }
            Rectangle {
                horizontal-stretch: 1; height: 54px;
                border-radius: Theme.radius-sm;
                background: preset2.has-hover ? Theme.panel-hi : Theme.bg-soft;
                border-width: 0px; border-color: Theme.line;
                HorizontalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: "" + root.preset-b; color: Theme.text; font-size: Theme.font-xl; font-weight: 600; vertical-alignment: center; }
                    Text { text: "℃"; color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; }
                }
                preset2 := TouchArea { mouse-cursor: pointer; clicked => { root.set-preset(root.preset-b); } }
            }
            Rectangle {
                horizontal-stretch: 1; height: 54px;
                border-radius: Theme.radius-sm;
                background: preset3.has-hover ? Theme.panel-hi : Theme.bg-soft;
                border-width: 0px; border-color: Theme.line;
                HorizontalLayout {
                    alignment: center; spacing: 2px;
                    Text { text: "" + root.preset-c; color: Theme.text; font-size: Theme.font-xl; font-weight: 600; vertical-alignment: center; }
                    Text { text: "℃"; color: Theme.text-mute; font-size: Theme.font-sm; vertical-alignment: center; }
                }
                preset3 := TouchArea { mouse-cursor: pointer; clicked => { root.set-preset(root.preset-c); } }
            }
        }
    }

        }
        VerticalLayout {
            width: (root.width - Theme.gap) * 0.38;
            spacing: Theme.gap;
            Card {
                title: "此刻，室内刚刚好"; background: Theme.sage-panel;
                HorizontalLayout {
                    height: 86px; spacing: 12px;
                    Metric { horizontal-stretch: 1; label: "温湿度计"; value: root.sensor-temp; unit: "°C"; }
                    Metric { horizontal-stretch: 1; label: "相对湿度"; value: root.sensor-hum; unit: "%"; }
                }
                Text { text: "空调室温 " + root.room-temp + "°C  ·  " + root.battery-text; color: Theme.text-dim; font-size: Theme.font-xs; }
            }
            Card {
                title: "把舒适交给它";
                ToggleRow { label: "ECO 节能"; on: root.eco; toggled(v) => { root.set-toggle("eco", v); } }
                ToggleRow { label: "睡眠模式"; on: root.sleep; toggled(v) => { root.set-toggle("sleep", v); } }
                ToggleRow { label: "辅助电热"; on: root.heater; toggled(v) => { root.set-toggle("heater", v); } }
                ToggleRow { label: "干燥防霉"; on: root.dryer; toggled(v) => { root.set-toggle("dryer", v); } }
                ToggleRow { label: "喜好模式"; on: root.favorite; toggled(v) => { root.set-toggle("favoriteOn", v); } }
                ToggleRow { label: "风感开关"; on: root.wind-on; toggled(v) => { root.set-toggle("windSensation", v); } }
            }
            Rectangle {
                height: 168px; border-radius: Theme.radius; background: Theme.energy-bg;
                VerticalLayout {
                    padding: 24px; spacing: 8px;
                    Text { text: "每一度，都心中有数"; color: Theme.energy-text; font-size: 18px; }
                    Text { text: root.energy-total + " kWh"; color: Theme.energy-text; font-size: 32px; }
                    Text { text: "累计用电量 · 详见电量统计"; color: Theme.energy-muted; font-size: Theme.font-xs; }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
    Card {
        title: "精细风向"; hint: "让风停在喜欢的位置";
        HorizontalLayout {
            spacing: 8px;
            SegButton { label: "风感关"; min-w: 72px; active: root.wind == 0; clicked => { root.set-wind(0); } }
            SegButton { label: "上吹"; min-w: 72px; active: root.wind == 1; clicked => { root.set-wind(1); } }
            SegButton { label: "下吹"; min-w: 72px; active: root.wind == 2; clicked => { root.set-wind(2); } }
            SegButton { label: "循环风"; min-w: 80px; active: root.wind == 3; clicked => { root.set-wind(3); } }
            SegButton { label: "防直吹"; min-w: 80px; active: root.wind == 4; clicked => { root.set-wind(4); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    // ── 定格 ──────────────────────────────────────────────────
    HorizontalLayout {
        spacing: Theme.gap;
        Card {
            title: "上下定格";
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 5px;
                SegButton { label: "关"; active: root.vpos == 0; clicked => { root.set-vpos(0); } }
                SegButton { label: "上"; active: root.vpos == 1; clicked => { root.set-vpos(1); } }
                SegButton { label: "偏上"; min-w: 50px; active: root.vpos == 2; clicked => { root.set-vpos(2); } }
                SegButton { label: "中"; active: root.vpos == 3; clicked => { root.set-vpos(3); } }
                SegButton { label: "偏下"; min-w: 50px; active: root.vpos == 4; clicked => { root.set-vpos(4); } }
                SegButton { label: "下"; active: root.vpos == 5; clicked => { root.set-vpos(5); } }
            }
        }
        Card {
            title: "左右定格";
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 5px;
                SegButton { label: "关"; active: root.hpos == 0; clicked => { root.set-hpos(0); } }
                SegButton { label: "左"; active: root.hpos == 1; clicked => { root.set-hpos(1); } }
                SegButton { label: "偏左"; min-w: 50px; active: root.hpos == 2; clicked => { root.set-hpos(2); } }
                SegButton { label: "中"; active: root.hpos == 3; clicked => { root.set-hpos(3); } }
                SegButton { label: "偏右"; min-w: 50px; active: root.hpos == 4; clicked => { root.set-hpos(4); } }
                SegButton { label: "右"; active: root.hpos == 5; clicked => { root.set-hpos(5); } }
            }
        }
    }

}
