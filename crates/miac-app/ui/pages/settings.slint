// ─────────────────────────────────────────────────────────────────────────────
// ui/pages/settings.slint —— 设置页
//
// 对应 index.html 的 <section data-view="settings">：
//   通信通道切换 / 设备信息 / 运行日志 / 关于
// ─────────────────────────────────────────────────────────────────────────────

import { Theme } from "../theme.slint";
import { Card, SegButton, FlatButton, ToggleRow } from "../common.slint";
import { ScrollView } from "std-widgets.slint";

export component SettingsPage inherits VerticalLayout {
    in property <int> transport-mode: 0;         // 0 自动 1 强制局域网 2 强制云端
    in property <string> device-info-text: "读取中…";
    in property <string> log-text: "—";
    in property <string> about-text: "";
    in property <bool> connected: false;
    in property <string> not-ready-reason: "";
    in property <string> migration-summary: "";
    in property <string> credentials-dir: "";
    in property <bool> credentials-encrypted: false;
    in property <string> credentials-status-title: "检查中…";
    in property <string> credentials-status-detail: "";
    in property <bool> auto-start: false;
    in property <bool> auto-start-pending: false;
    in property <int> close-behavior: 0;
    callback set-auto-start(bool);
    callback set-close-behavior(int);

    callback set-transport(int);
    callback export-log();
    callback clear-log();
    callback encrypt-credentials();
    callback delete-credentials();

    spacing: Theme.gap;

    Card {
        title: "软件设置";
        HorizontalLayout {
            height: 40px;
            spacing: 12px;
            ToggleRow {
                width: 300px; height: 40px;
                label: "开机自启动";
                on: root.auto-start;
                enabled: !root.auto-start-pending;
                toggled(v) => { root.set-auto-start(v); }
            }
            Text { text: root.auto-start-pending ? "正在保存设置…" : "登录 Windows 后自动打开，默认关闭。"; color: Theme.text-mute; font-size: Theme.font-xs; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 12px;
            Text { text: "关闭窗口"; color: Theme.text-dim; font-size: Theme.font-sm; vertical-alignment: center; }
            SegButton { label: "每次询问"; min-w: 104px; active: root.close-behavior == 0; clicked => { root.set-close-behavior(0); } }
            SegButton { label: "收到托盘"; min-w: 104px; active: root.close-behavior == 1; clicked => { root.set-close-behavior(1); } }
            SegButton { label: "直接退出"; min-w: 104px; active: root.close-behavior == 2; clicked => { root.set-close-behavior(2); } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: "退出程序不会关闭空调。选择「每次询问」可重新显示关闭提示。"; color: Theme.text-mute; font-size: Theme.font-xs; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 12px;
            Text { text: "本机数据"; color: Theme.text-dim; font-size: Theme.font-sm; vertical-alignment: center; }
            FlatButton {
                label: "一键删除凭证";
                min-w: 144px;
                max-width: 144px;
                danger: true;
                clicked => { root.delete-credentials(); }
            }
            Text { text: "清除凭证、设置和缓存，完成后重新扫码登录。"; color: Theme.text-mute; font-size: Theme.font-xs; vertical-alignment: center; wrap: word-wrap; }
            Rectangle { horizontal-stretch: 1; }
        }
    }

    HorizontalLayout {
        spacing: Theme.gap;
        VerticalLayout { width: (root.width - Theme.gap) * 0.62; spacing: Theme.gap;
    Card {
        title: "连接状态";
        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            Rectangle {
                width: 10px; height: 10px; border-radius: 5px;
                background: root.connected ? Theme.green : Theme.amber;
            }
            Text {
                text: root.connected ? "已连接，可以读取与下发" : "未连接";
                color: root.connected ? Theme.green : Theme.amber;
                font-size: Theme.font-md;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.connected ? "" : root.not-ready-reason;
                color: Theme.text-dim;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: "通信通道";
            color: Theme.text-mute;
            font-size: Theme.font-xs;
        }
        HorizontalLayout {
            spacing: 8px;
            SegButton { label: "自动（局域网优先）"; min-w: 164px; active: root.transport-mode == 0; clicked => { root.set-transport(0); } }
            SegButton { label: "强制局域网"; min-w: 104px; active: root.transport-mode == 1; clicked => { root.set-transport(1); } }
            SegButton { label: "强制云端"; min-w: 92px; active: root.transport-mode == 2; clicked => { root.set-transport(2); } }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Card {
        title: "设备信息";
        Text {
            text: root.device-info-text;
            color: Theme.text-dim;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
    Card {
        title: "运行日志";
        HorizontalLayout {
            height: 38px;
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            FlatButton { label: "导出日志"; min-w: 88px; max-width: 88px; clicked => { root.export-log(); } }
            FlatButton { label: "清空"; ghost: true; min-w: 60px; max-width: 60px; clicked => { root.clear-log(); } }
        }
        Text { text: "导出本次运行的最近 200 条日志；分享前请检查设备名称等信息。"; color: Theme.text-mute; font-size: Theme.font-xs; wrap: word-wrap; }
        Rectangle {
            height: 168px;
            border-radius: Theme.radius-sm;
            background: Theme.bg;
            border-width: 1px;
            border-color: Theme.line-soft;
            clip: true;
            log-scroll := ScrollView {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                content-width: self.visible-width;
                content-height: max(self.visible-height, log-content.preferred-height);
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                // A cleared or shortened log must not retain an old offset.
                changed content-height => {
                    self.content-y = clamp(self.content-y, min(0px, self.visible-height - self.content-height), 0px);
                }
                log-content := Text {
                    // Reserve the scrollbar's hit area even while it is hidden,
                    // so long lines wrap without moving under the thumb.
                    width: log-scroll.visible-width - 18px;
                    text: root.log-text;
                    color: Theme.text-dim;
                    font-size: Theme.font-xs;
                    wrap: word-wrap;
                }
            }
        }
    }
            Rectangle { vertical-stretch: 1; }
        }
        VerticalLayout { width: (root.width - Theme.gap) * 0.38; spacing: Theme.gap;
    Card {
        title: "本机凭据"; background: Theme.sage-panel;
        Text { text: root.credentials-status-title; color: Theme.text-dim; font-size: Theme.font-sm; }
        Text {
            text: "存储位置：" + (root.credentials-dir == "" ? "—" : root.credentials-dir);
            color: Theme.text-dim;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        Text {
            text: root.credentials-status-detail;
            color: Theme.text-mute;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        HorizontalLayout {
            height: 32px;
            spacing: 10px;
            FlatButton {
                label: root.credentials-encrypted ? "当前凭据已加密" : "加密现有凭据";
                min-w: 150px;
                danger: !root.credentials-encrypted;
                clicked => { root.encrypt-credentials(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    Card {
        title: "旧版数据迁移";
        hint: "首次启动自动执行";
        Text {
            text: root.migration-summary == "" ? "尚未执行迁移" : root.migration-summary;
            color: Theme.text-dim;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
    Card {
        title: "通道说明";
        Text {
            text: "局域网直连约 0.4 秒，且实测米家 App 约 1 秒内同步显示（设备会主动向小米云上报）。云端 RPC 约 1–2 秒，仅在设备不在同一局域网时使用。";
            color: Theme.text-mute;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
    }
    Card {
        title: "关于";
        Text {
            text: root.about-text;
            color: Theme.text-dim;
            font-size: Theme.font-sm;
            wrap: word-wrap;
        }
        Text {
            text: "凭据只保存在本机 device.json / cloud-session.json / thermometer.json，不随应用分发，请勿外传。";
            color: Theme.text-mute;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
    }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
